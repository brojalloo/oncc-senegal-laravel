{
  "name": "ONCC Sénégal",
  "description": "Observatoire National sur les Changements Climatiques du Sénégal - Plateforme de gestion et visualisation des données climatiques et économiques",
  "keywords": ["laravel", "climate", "senegal", "data-visualization", "economic-data"],
  "website": "https://github.com/brojalloo/oncc-senegal-laravel",
  "repository": "https://github.com/brojalloo/oncc-senegal-laravel",
  "success_url": "/dashboard",
  "engines": {
    "php": "^8.2",
    "node": "18.x"
  },
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "value": "ONCC Sénégal"
    },
    "APP_ENV": {
      "description": "Application environment", 
      "value": "production"
    },
    "APP_KEY": {
      "description": "Laravel application key",
      "generator": "secret"
    },
    "APP_DEBUG": {
      "description": "Enable debug mode",
      "value": "false"
    },
    "DB_CONNECTION": {
      "description": "Database connection type",
      "value": "sqlite"
    }
  },
  "formation": {
    "web": {
      "quantity": 1
    }
  },
  "buildpacks": [
    {
      "url": "heroku/php"
    }
  ],
  "scripts": {
    "build": [
      "php artisan config:cache",
      "php artisan route:cache", 
      "php artisan view:cache"
    ],
    "postdeploy": [
      "touch database/database.sqlite",
      "php artisan migrate --force",
      "php artisan db:seed --force"
    ]
  }
}