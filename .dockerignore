# Sans ce fichier, `COPY . .` embarque le .env local (donc APP_KEY et les
# identifiants de messagerie) dans une couche de l'image, ainsi que .git et
# node_modules.

.git
.github
.gitignore
.gitattributes
.editorconfig

.env
.env.*
!.env.example

node_modules
vendor
public/build
public/hot
public/storage

storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
!storage/**/.gitignore

# bootstrap/cache/config.php est la configuration sérialisée : il contient
# APP_KEY et les mots de passe de base et de messagerie. Si un développeur a
# lancé config:cache, l'exclure évite que ses secrets se retrouvent figés dans
# une couche de l'image. L'entrypoint régénère ces fichiers au démarrage.
bootstrap/cache/*
!bootstrap/cache/.gitignore

database/*.sqlite
database/*.sqlite-journal

.worktrees
docs
tests
phpunit.xml
.phpunit.result.cache

Dockerfile
.dockerignore
docker-compose.yml
*.md
